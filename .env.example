# Copy to .env (`cp .env.example .env`) and fill in TWOC2P_SECRET_KEY. Read by docker compose;
# .env is git-ignored and never committed.

# 2C2P sandbox (Payment API v4.3). JT01 is the public Singapore (SGD) demo merchant; its secret
# key is published on https://developer.2c2p.com/docs/sandbox (row "Singapore").
TWOC2P_MERCHANT_ID=JT01
TWOC2P_SECRET_KEY=

# This API's public URL, which 2C2P posts the backend notification to. Leave it as is to try the
# app locally: payments are then confirmed by Payment Inquiry when the result page polls. For
# real notifications, run a tunnel (see README) and put its https URL here.
PUBLIC_API_URL=http://localhost:8080

# Host ports MySQL and Redis are published on. Change them only if something on your machine
# already uses 3306 or 6379 (e.g. a local MySQL/Redis).
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
