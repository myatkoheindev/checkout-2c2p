{
  "Application": {
    "Name": "Checkout API"
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3306;Database=checkout;User=checkout;Password=checkout",
    "Redis": "127.0.0.1:6379"
  },
  "Checkout": {
    "PublicApiUrl": "http://localhost:8080"
  },
  "TwoC2P": {
    "MerchantId": "JT01"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
