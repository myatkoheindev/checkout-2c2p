<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The HTTP edge: routing, request binding, errors, and the OpenAPI document. JSON only. -->
  <PropertyGroup>
    <RootNamespace>Checkout.Api</RootNamespace>
    <UserSecretsId>checkout-2c2p-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Checkout.Application\Checkout.Application.csproj" />
    <ProjectReference Include="..\Checkout.Infrastructure\Checkout.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- dotnet ef runs with the API as its startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Checkout.Api.Tests" />
  </ItemGroup>

</Project>
