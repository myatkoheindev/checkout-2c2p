<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters: EF Core repositories on MySQL, Redis (cache and lock), the 2C2P Payment API, and service registration for every layer below the API. -->
  <PropertyGroup>
    <RootNamespace>Checkout.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Checkout.Application\Checkout.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Checkout.Api.Tests" />
    <InternalsVisibleTo Include="Checkout.Infrastructure.Tests" />
  </ItemGroup>

</Project>
